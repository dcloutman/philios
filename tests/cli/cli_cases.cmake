# Plan 0001 §9 CLI golden acceptance cases, included from CMakeLists.txt inside its
# BUILD_TESTING block. Every entry runs the real `philios` binary through
# tests/cli/run_case.cmake (status, stderr class/line/column or usage/startup text, empty
# stdout). Fixtures live in tests/cli/cases/; large and structural inputs are generated by
# the driver. Unit-only parts of §9 (T-CLI-8..10, T-LEX-12, T-RUN-4, T-FN-4/6, T-NULL-4,
# T-SEC-3/5..8, T-OWN-1/2/4/5, T-DECL-8/9) are Catch2 tests. T-OWN-3 is these cases run in
# build-asan, where any ASan/LSan report changes the status or stderr and fails the case.

# T-CLI-1: any argument is a usage error (64), whatever main.phil holds.
philios_cli_test(t_cli_1_argument_x FIXTURE cli1_valid_program.phil ARGS x STATUS 64 KIND usage)
philios_cli_test(t_cli_1_argument_help FIXTURE cli1_valid_program.phil ARGS --help STATUS 64
    KIND usage)

# T-CLI-2 to T-CLI-4: loading failures are startup errors naming main.phil (66).
philios_cli_test(t_cli_2_missing_main_phil MODE none STATUS 66 KIND startup)
philios_cli_test(t_cli_3_directory MODE directory STATUS 66 KIND startup)
philios_cli_test(t_cli_3_fifo MODE fifo STATUS 66 KIND startup)
philios_cli_test(t_cli_3_symlink_to_regular_file MODE symlink FIXTURE cli1_valid_program.phil
    STATUS 66 KIND startup)
philios_cli_test(t_cli_3_dangling_symlink MODE dangling STATUS 66 KIND startup)
philios_cli_test(t_cli_4_unreadable MODE unreadable FIXTURE cli1_valid_program.phil STATUS 66
    KIND startup SKIP_LABEL T-CLI-4)

# T-CLI-5: the 2 MiB limit (D21); padded programs are generated at test time.
