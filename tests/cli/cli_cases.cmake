philios_cli_test(t_cli_5_size_2097152 MODE sized SIZE 2097152 EXIT_VALUE 42 STATUS 42 KIND empty)
philios_cli_test(t_cli_5_size_2097153 MODE sized SIZE 2097153 EXIT_VALUE 42 STATUS 66
